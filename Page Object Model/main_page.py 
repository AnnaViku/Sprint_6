import allure
from selenium.webdriver.common.by import By
from base_page import BasePage  # Импортируем базовый класс

class MainPage(BasePage):
    ORDER_BUTTON = (By.XPATH, "//button[text()='Заказать']")
    LOGO_SCOOTER = (By.XPATH, "//a[@href='/']")
    LOGO_YANDEX = (By.XPATH, "//a[contains(@href, 'zen.yandex.ru')]")
    
    QUESTION_LOCATORS = {
        0: (By.XPATH, "//div[text()='Как заказать самокат?']"),
        1: (By.XPATH, "//div[text()='Когда привезут самокат?']"),
        2: (By.XPATH, "//div[text()='Как отменить заказ?']")
    }
    
    ANSWER_LOCATORS = {
        0: (By.XPATH, "//div[contains(@class, 'accordion__panel')][1]"),
        1: (By.XPATH, "//div[contains(@class, 'accordion__panel')][2]"),
        2: (By.XPATH, "//div[contains(@class, 'accordion__panel')][3]")
    }

    def __init__(self, driver):
        super().__init__(driver)  # Инициализируем базовый класс

    @allure.step("Нажимаем кнопку 'Заказать'")
    def click_order_button(self):
        self.click(*self.ORDER_BUTTON)

    @allure.step("Кликаем по вопросу FAQ с индексом {index}")
    def click_faq_question(self, index):
        self.click(*self.QUESTION_LOCATORS[index])

    @allure.step("Получаем текст ответа для вопроса с индексом {index}")
    def get_faq_answer_text(self, index):
        return self.get_text(*self.ANSWER_LOCATORS[index])